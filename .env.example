# Public production URL, no trailing slash. Defaults to https://winfintechnologies.com.
# NEXT_PUBLIC_SITE_URL=https://winfintechnologies.com

# Set to "true" only for the production build (the GitHub Pages workflow does).
# Without it every page is noindex.
# ALLOW_INDEXING=true

# Contact form: an endpoint that accepts a JSON POST from the browser and
# returns 2xx on success, e.g. a Formspree form (https://formspree.io).
# Without it, the form opens the visitor's email app instead.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
