# Public production URL, no trailing slash (canonical URLs, Open Graph, sitemap,
# structured data). Use the exact host you want in search results (www or not).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to "true" ONLY for the production deployment on the public domain.
# Anywhere else (local, staging, Vercel previews) leave it unset: every page is
# then served with noindex. On Vercel, preview deployments stay noindex even if set.
# ALLOW_INDEXING=true

# --- Contact form backend: configure ONE option ---

# Option A: any endpoint that accepts a JSON POST (Formspree, Make, Zapier, n8n, your own API)
# CONTACT_WEBHOOK_URL=https://formspree.io/f/xxxxxxx

# Option B: send email through Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=support@oppuna.com
# CONTACT_FROM_EMAIL="Winfin Website <website@your-verified-domain.com>"
